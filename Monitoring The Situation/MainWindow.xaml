<Window x:Class="Monitoring_The_Situation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YourApp" Height="720" Width="1280"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!--Colours-->
        <SolidColorBrush x:Key="BackgroundBrush"    Color="#1A1A2E"/>
        <SolidColorBrush x:Key="NavBarBrush"         Color="#16213E"/>
        <SolidColorBrush x:Key="TabActiveBrush"      Color="#0F3460"/>
        <SolidColorBrush x:Key="TabHoverBrush"       Color="#1A2E4A"/>
        <SolidColorBrush x:Key="TabInactiveBrush"    Color="Transparent"/>
        <SolidColorBrush x:Key="AccentBrush"         Color="#E94560"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#EAEAEA"/>
        <SolidColorBrush x:Key="TextMutedBrush"      Color="#7A8CA0"/>
        <SolidColorBrush x:Key="CellBorderBrush"     Color="#0F3460"/>
        <SolidColorBrush x:Key="CellBackgroundBrush" Color="#16213E"/>
        <SolidColorBrush x:Key="HandleBrush"         Color="#E94560"/>
        <SolidColorBrush x:Key="HandleHoverBrush"    Color="#FF6B81"/>
        <SolidColorBrush x:Key="DragPreviewBrush"    Color="#55E94560"/>

        <!--Tab Button Hover Style-->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        
                        <ControlTemplate.Triggers>

                            <!--Hover-->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2A3B5A"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>

                            <!--Pressed-->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0F3460"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Tab Item Style-->
        <Style x:Key="BrowserTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground"       Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background"       Value="{StaticResource TabInactiveBrush}"/>
            <Setter Property="BorderThickness"       Value="0"/>
            <Setter Property="Padding"       Value="0"/>
            <Setter Property="MinWidth"       Value="140"/>
            <Setter Property="MaxWidth"       Value="220"/>
            <Setter Property="Height"       Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="TabRoot">
                            <!--Active tab indicator-->
                            <Border x:Name="ActiveBar"
                                    Height="2" VerticalAlignment="Bottom"
                                    Background="{StaticResource AccentBrush}"
                                    Opacity="0"/>
                            <!--Tab background-->
                            <Border x:Name="TabBg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6 6 0 0"
                                    Margin="2 4 2 0">
                                <DockPanel Margin="12 0 8 0" LastChildFill="True">
                                <!--Tab label-->
                                <TextBlock x:Name="TabLabel"
                                           DockPanel.Dock="Left"
                                           Text="{TemplateBinding Header}"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI"
                                           FontSize="13"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!--Close button-->
                                <Button x:Name="CloseBtn"
                                        Style="{StaticResource TabButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Content="✕"
                                        Width="18" Height="18"
                                        Margin="6 0 0 0"
                                        Padding="0"
                                        FontSize="9"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Opacity="1"
                                        Click="CloseTabButton_Click"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!--Selected state-->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBg"      Property="Background" Value="{StaticResource TabActiveBrush}"/>
                                <Setter TargetName="TabLabel"   Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="TabLabel"   Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="ActiveBar"  Property="Opacity" Value="1"/>
                            </Trigger>
                            <!--Hover state-->
                            <Trigger SourceName="TabBg" Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg"  Property="Background" Value="{StaticResource TabHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!--TabControl Style-->
        <Style x:Key="BrowserTabControlStyle" TargetType="TabControl">
            <Setter Property="Background"       Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel Background="{TemplateBinding Background}">
                            <!--Nav Bar-->
                            <Border DockPanel.Dock="Top"
                                    Background="{StaticResource NavBarBrush}"
                                    Height="46"
                                    BorderBrush="{StaticResource CellBorderBrush}"
                                    BorderThickness="0 0 0 1">
                                <DockPanel Margin="4 0">
                                    <!--New tab button-->
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource TabButtonStyle}"
                                            Content="+"
                                            Width="34" Height="34"
                                            Margin="4 0"
                                            FontSize="16"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="New Tab"
                                            Click="AddTabButton_Click"/>
                                    <!--Tab strip-->
                                    <TabPanel x:Name="HeaderPanel"
                                              IsItemsHost="True"
                                              VerticalAlignment="Bottom"
                                              HorizontalAlignment="Left"
                                              Background="Transparent"/>
                                </DockPanel>
                            </Border>
                            <!--Page Content-->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Grid Cell Border Style-->
        <Style x:Key="GridCellStyle" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource CellBackgroundBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource CellBorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="6"/>
        </Style>
    </Window.Resources>

    <!-- ROOT TabControl -->
    <TabControl x:Name="MainTabControl"
                Style="{StaticResource BrowserTabControlStyle}">
        <TabItem Header="Tab 1" Style="{StaticResource BrowserTabItemStyle}">
            <!--
                Each tab's content is a Canvas.
                ResizableGridHost (code-behind) owns it and places
                cell Borders + drag Thumbs as Canvas children.
            -->
            <Canvas x:Name="InitialGridCanvas"
                    Background="{StaticResource BackgroundBrush}"
                    SizeChanged="GridCanvas_SizeChanged"/>
        </TabItem>
    </TabControl>
</Window>
